---
import IndexLayout from "../layouts/IndexLayout.astro";
const pageTitle = "Queer as Lot";
---

<IndexLayout pageTitle={pageTitle}>
  <main>
    <div id="hero">
      <img class="logo_300" />
      <h1>{pageTitle}</h1>
      <table aria-hidden="true">
        <tr>
          <td class="color1"></td>
          <td class="color2"></td>
          <td class="color3"></td>
          <td class="color4"></td>
          <td class="color5"></td>
          <td class="color6"></td>
        </tr>
      </table>
      <h2>Sport & Culture</h2>
    </div>
  </main>
</IndexLayout>
