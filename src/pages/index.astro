---
import BaseLayout from "../layouts/BaseLayout.astro";
import qalLogoBlack from "../assets/lsn-xsmall.png";
const pageTitle = "Queer as Lot";
---

<BaseLayout pageTitle={pageTitle}>
  <div>
    <img
      src={qalLogoBlack.src}
      alt="dessin blanc sur fond noir de gallinacée à crête qui sort d'un oeuf boule à facette"
    />
    <h1>{pageTitle}</h1>
    <table aria-hidden="true">
      <tr>
        <td class="color1"></td>
        <td class="color2"></td>
        <td class="color3"></td>
        <td class="color4"></td>
        <td class="color5"></td>
        <td class="color6"></td>
      </tr>
    </table>
    <h2>Sport et Culture</h2>
  </div>
</BaseLayout>
