---
import qalLogo from "../assets/lsb.svg";
import barArcenciel from "../assets/Barcenciel.svg";
---

<div id="container">
  <main>
    <section id="hero">
      <img src={qalLogo.src} alt="logo queer as lot" class="main-logo" />
      <h1>QUEER AS LOT</h1>
      <img
        src={barArcenciel.src}
        alt="barre decorative arc-en-ciel"
        id="barcenciel"
      />
      <h2>SPORT & CULTURE</h2>
      <h3>Le site arrive bientôt!</h3>
      <section id="links"></section>
      <a href="https://www.instagram.com/queer.as.lot/">instagram</a>
    </section>
  </main>
</div>

<style>
  #container {
    font-family: "Barlow", sans-serif;
    height: 100%;
  }

  main {
    display: flex;
    justify-content: center;
  }

  #hero {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
  }

  .main-logo {
    height: 50%;
  }

  h1 {
    font-family: "League Spartan Variable", sans-serif;
    font-weight: 700;
    font-size: xxx-large;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-family: "Cooper Hewitt", sans-serif;
    font-size: xx-large;
  }

  h3 {
    font-family: "Barlow", sans-serif;
  }

  #barcenciel {
    height: 1rem;
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }
  }
</style>
