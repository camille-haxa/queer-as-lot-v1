---
import "@fontsource-variable/league-spartan";
import "@fontsource/cooper-hewitt";
import "@fontsource/barlow";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import logoB from "../assets/logos/logo-noir-200.png";
const { pageTitle } = Astro.props;
// layout for complete website
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg" href="/favicon1.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <div id="pages-layout">
      <img src={logoB.src} alt="" />
      <h1>{pageTitle}</h1>
      <table aria-hidden="true" id="pages-decoration">
        <tr>
          <td class="color1"></td>
          <td class="color2"></td>
          <td class="color3"></td>
          <td class="color4"></td>
          <td class="color5"></td>
          <td class="color6"></td>
        </tr>
      </table>
    </div>
    <slot />
    <Footer />
    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
